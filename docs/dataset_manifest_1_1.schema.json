{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minemat-ai:schema:dataset-manifest:1.1",
  "title": "MineMat AI dataset manifest, schema 1.1",
  "description": "Provenance, licence, permitted use, labels, checksums and split assignments for an image dataset. Structural rules only: cross-record rules (unique IDs, one split per physical sample, permission consistency, file checksums) are enforced by apps/api/scripts/validate_dataset_manifest.py. Patterns end in (?![\\s\\S]) instead of $ so that a trailing newline is not accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "[^\\s]"
    },
    "short_text": {
      "type": "string",
      "maxLength": 200,
      "pattern": "[^\\s]"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "http_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+(?![\\s\\S])"
    },
    "doi": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^10\\.[0-9]{4,9}/[^\\s]+(?![\\s\\S])"
    },
    "relative_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f]+(?![\\s\\S])"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "independent_evaluation",
        "unassigned"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "name",
        "description",
        "category",
        "source",
        "licence",
        "permissions",
        "sample_identity"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/short_text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "enum": [
            "public",
            "synthetic",
            "umat_practical",
            "ghana_field"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "licence": {
          "$ref": "#/$defs/licence"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "sample_identity": {
          "$ref": "#/$defs/sample_identity"
        },
        "label_vocabulary": {
          "$ref": "#/$defs/label_vocabulary"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/short_text"
        },
        "url": {
          "$ref": "#/$defs/http_url"
        },
        "doi": {
          "$ref": "#/$defs/doi"
        },
        "custodian": {
          "$ref": "#/$defs/short_text"
        },
        "retrieved_on": {
          "$ref": "#/$defs/date"
        },
        "citation": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/short_text"
        },
        "version": {
          "$ref": "#/$defs/short_text"
        },
        "url": {
          "$ref": "#/$defs/http_url"
        },
        "spdx_id": {
          "$ref": "#/$defs/short_text"
        },
        "usage_notes": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/licence_evidence"
        }
      }
    },
    "licence_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_on"
      ],
      "properties": {
        "captured_on": {
          "$ref": "#/$defs/date"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_path",
            "sha256"
          ],
          "properties": {
            "relative_path": {
              "$ref": "#/$defs/relative_path"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "archive_url": {
          "$ref": "#/$defs/http_url"
        },
        "reference": {
          "$ref": "#/$defs/short_text"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "anyOf": [
        {
          "required": [
            "snapshot"
          ]
        },
        {
          "required": [
            "archive_url"
          ]
        },
        {
          "required": [
            "reference"
          ]
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "permitted_uses",
        "commercial_training"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "pending_review",
            "denied",
            "unknown"
          ]
        },
        "permitted_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "training",
              "validation",
              "testing",
              "independent_evaluation"
            ]
          }
        },
        "commercial_training": {
          "enum": [
            "permitted",
            "not_permitted",
            "unknown"
          ]
        },
        "commercial_training_basis": {
          "$ref": "#/$defs/text"
        },
        "reviewed_by": {
          "$ref": "#/$defs/short_text"
        },
        "reviewed_on": {
          "$ref": "#/$defs/date"
        },
        "authorisation_reference": {
          "$ref": "#/$defs/short_text"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reviewed_by",
          "reviewed_on"
        ]
      }
    },
    "sample_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis"
      ],
      "properties": {
        "basis": {
          "enum": [
            "recorded_by_collector",
            "declared_by_source",
            "inferred_by_documented_analysis",
            "assumed_each_image_distinct"
          ]
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "label_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary_id",
        "version",
        "categories"
      ],
      "properties": {
        "vocabulary_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/short_text"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/short_text"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "physical_sample_id",
        "file",
        "split"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/identifier"
        },
        "physical_sample_id": {
          "$ref": "#/$defs/identifier"
        },
        "capture_session_id": {
          "$ref": "#/$defs/identifier"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "split": {
          "$ref": "#/$defs/split"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "acquisition": {
          "$ref": "#/$defs/acquisition"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^/\\\\\\u0000-\\u001f]+(?![\\s\\S])"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_category",
        "source"
      ],
      "properties": {
        "material_category": {
          "$ref": "#/$defs/short_text"
        },
        "source": {
          "$ref": "#/$defs/label_source"
        }
      }
    },
    "label_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "source_dataset",
            "human_visual",
            "laboratory_derived",
            "model_generated"
          ]
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "annotator_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "annotated_on": {
          "$ref": "#/$defs/date"
        },
        "adjudicated": {
          "type": "boolean"
        },
        "guideline_reference": {
          "$ref": "#/$defs/short_text"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "lighting": {
          "$ref": "#/$defs/short_text"
        },
        "moisture_condition": {
          "$ref": "#/$defs/short_text"
        },
        "scale_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "description": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "make": {
              "$ref": "#/$defs/short_text"
            },
            "model": {
              "$ref": "#/$defs/short_text"
            },
            "notes": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "viewpoint": {
          "$ref": "#/$defs/short_text"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_id",
              "record_id"
            ],
            "properties": {
              "dataset_id": {
                "$ref": "#/$defs/identifier"
              },
              "record_id": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "processing_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "$ref": "#/$defs/text"
              },
              "tool": {
                "$ref": "#/$defs/short_text"
              }
            }
          }
        }
      }
    }
  }
}
